generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OutageReport {
  id          String   @id @default(cuid())
  area        String   // e.g. "Lumley", "Wellington"
  city        String   @default("Freetown")
  status      String   // "out" | "on"
  reportedAt  DateTime @default(now())
  expiresAt   DateTime
  confirmed   Boolean  @default(false)
  reportCount Int      @default(1)
  deviceId    String?  // To prevent duplicate reports from the same device
  reporterLat Float?   // For location validation
  reporterLng Float?   // For location validation

  @@index([area, city])
  @@index([expiresAt])
  @@index([deviceId, area, reportedAt])
}

model AreaStatus {
  id          String   @id @default(cuid())
  area        String   @unique
  city        String   @default("Freetown")
  status      String   @default("unknown") // "on" | "out" | "unknown"
  confidence  Int      @default(0) // 0-100
  reportCount Int      @default(0)
  lastUpdated DateTime @default(now())
  confirmedAt DateTime?
}

model HazardReport {
  id          String   @id @default(cuid())
  type        String   // "Falling Pole", "Sparking Cable", "Other"
  description String?
  streetName  String?
  houseNumber String?
  areaName    String? // Specific local area or community name
  imageUrl    String?  // URL to pictorial evidence
  area        String
  city        String   @default("Freetown")
  reportedAt  DateTime @default(now())
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // Email of the admin who resolved it
  deviceId    String?
  meterNumber String?
  contactPhone String?
  lat         Float?
  lng         Float?

  @@index([area, city])
  @@index([reportedAt])
  @@index([resolved])
}

model AdminUser {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String
  isSuperAdmin        Boolean                  @default(false)
  emailVerified       DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  resetTokens         PasswordResetToken[]
  emailVerifTokens    EmailVerificationToken[]

  @@index([email])
}

model FeedbackSubmission {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  category  String   @default("General")
  rating    Int      @default(5)
  area      String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String
  expiresAt DateTime?

  @@index([active, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  adminEmail String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DirectVendingTransaction {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  meterNumber      String
  amountMinor      Int
  currency         String   @default("SLE")
  status           String   @default("pending")
  commissionBps    Int?
  gatewayReference String?
  tokenReference   String?
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([meterNumber, createdAt])
  @@index([status, createdAt])
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}
